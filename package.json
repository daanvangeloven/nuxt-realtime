{
  "name": "nuxt-realtime",
  "version": "0.0.5",
  "description": "WebSocket integration for Nuxt 3",
  "repository": {
    "type": "git",
    "url": "https://github.com/daanvangeloven/nuxt-realtime"
  },
  "license": "MIT",
  "type": "module",
  "authors": [
    {
      "name": "Jordan van Wijnen",
      "url": "https://github.com/milkyontheblock/"
    },
    {
      "name": "Daan van Geloven",
      "url": "https://github.com/daanvangeloven/"
    }
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "pnpm run dev:prepare && pnpm run dev:playground",
    "dev:playground": "nuxi dev playground",
    "dev:docs": "nuxi dev docs",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground && nuxi prepare docs",
    "build:docs": "nuxi build docs",
    "generate:docs": "nuxi generate docs",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd docs && pnpm typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "@nuxt/kit": "^4.3.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@nuxt/devtools": "^3.2.2",
    "@nuxt/eslint-config": "^1.15.2",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.3.1",
    "@nuxt/test-utils": "^3.23.0",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "eslint": "^9.39.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "nuxt": "^4.3.1",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.5"
  },
  "packageManager": "pnpm@10.19.0+sha512.c9fc7236e92adf5c8af42fd5bf1612df99c2ceb62f27047032f4720b33f8eacdde311865e91c411f2774f618d82f320808ecb51718bfa82c060c4ba7c76a32b8",
  "pnpm": {
    "overrides": {
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "devalue@<=5.6.2": ">=5.6.3",
      "h3@<=1.15.4": ">=1.15.5",
      "tar@<=7.5.9": ">=7.5.10",
      "lodash-es@>=4.0.0 <=4.17.22": ">=4.17.23",
      "lodash@>=4.0.0 <=4.17.22": ">=4.17.23",
      "seroval@<1.4.1": ">=1.4.1",
      "@isaacs/brace-expansion@<=5.0.0": ">=5.0.1",
      "markdown-it@>=13.0.0 <14.1.1": ">=14.1.1",
      "ajv@<6.14.0": ">=6.14.0 <7",
      "minimatch@<3.1.3": ">=3.1.3",
      "minimatch@>=10.0.0 <10.2.1": ">=10.2.1",
      "serialize-javascript@<=7.0.2": ">=7.0.3",
      "svgo@=4.0.0": ">=4.0.1",
      "dompurify@>=3.1.3 <=3.3.1": ">=3.3.2"
    }
  }
}

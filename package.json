{
 "name": "nuxt-realtime",
  "version": "0.0.1",
  "description": "WebSocket integration for Nuxt 3",
  "repository": {
    "type": "git",
    "url": "https://github.com/daanvangeloven/nuxt-realtime"
  },
  "license": "MIT",
  "type": "module",
   "authors": [
    {
      "name": "Jordan van Wijnen",
      "url": "https://github.com/milkyontheblock/"
       
    },
    {
      "name": "Daan van Geloven",
      "url": "https://github.com/daanvangeloven/"

    }
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.2.1"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.1.1",
    "@nuxt/eslint-config": "^1.11.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.2.1",
    "@nuxt/test-utils": "^3.21.0",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "eslint": "^9.39.1",
    "nuxt": "^4.2.1",
    "typescript": "~5.9.3",
    "vitest": "^4.0.15",
    "vue-tsc": "^3.1.7"
  }
}

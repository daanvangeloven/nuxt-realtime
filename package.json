{
  "name": "nuxt-realtime",
  "version": "0.2.0",
  "description": "WebSocket integration for Nuxt 3",
  "repository": {
    "type": "git",
    "url": "https://github.com/daanvangeloven/nuxt-realtime"
  },
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Daan van Geloven",
    "url": "https://github.com/daanvangeloven/"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./drivers/redis": {
      "types": "./dist/drivers/redis.d.mts",
      "import": "./dist/drivers/redis.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "drivers/redis": [
        "./dist/drivers/redis.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "client/dist"
  ],
  "scripts": {
    "postinstall": "nuxt-module-build prepare",
    "prepack": "nuxt-module-build prepare && nuxt-module-build build && pnpm run build:devtools-client",
    "dev": "pnpm run dev:prepare && pnpm run dev:playground",
    "dev:playground": "nuxi dev playground",
    "dev:docs": "nuxi dev docs",
    "dev:devtools-client": "nuxi dev client --port 3300",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && pnpm run build:devtools-client && nuxi prepare playground && nuxi prepare docs",
    "build:docs": "nuxi build docs",
    "build:devtools-client": "nuxi generate client",
    "generate:docs": "nuxi generate docs",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd docs && pnpm typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "@nuxt/devtools-kit": "^3.2.2",
    "@nuxt/kit": "^4.4.7",
    "ofetch": "^1.4.1",
    "sirv": "^3.0.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "peerDependencies": {
    "ioredis": ">=5"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@nuxt/devtools": "^3.3.1",
    "@nuxt/eslint-config": "^1.15.2",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.7",
    "@nuxt/test-utils": "^3.23.0",
    "@types/node": "^26.2.0",
    "changelogen": "^0.6.2",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "ioredis": "^5.0.0",
    "lint-staged": "^16.2.7",
    "nuxt": "^4.5.1",
    "playwright-core": "^1.62.1",
    "typescript": "~5.9.3",
    "unstorage": "latest",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.3"
  },
  "packageManager": "pnpm@10.19.0+sha512.c9fc7236e92adf5c8af42fd5bf1612df99c2ceb62f27047032f4720b33f8eacdde311865e91c411f2774f618d82f320808ecb51718bfa82c060c4ba7c76a32b8"
}
